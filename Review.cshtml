@model IEnumerable<ContractMonthlyClaimSystem.Models.Claim>
@{
    ViewData["Title"] = "Review Claims (Coordinator/Manager)";
}

<h2>Pending Claims</h2>

<table class="table">
    <thead>
        <tr>
            <th>Lecturer</th>
            <th>Date</th>
            <th>Hours</th>
            <th>Total</th>
            <th>Notes</th>
            <th>Doc</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var c in Model)
    {
        <tr>
            <td>@c.LecturerId</td>
            <td>@c.DateSubmitted.ToLocalTime()</td>
            <td>@c.HoursWorked</td>
            <td>@c.TotalAmount</td>
            <td>@c.Notes</td>
            <td>
                @if (!string.IsNullOrEmpty(c.DocumentPath))
                {
                    <a asp-action="Download" asp-route-id="@c.ClaimId">View</a>
                }
            </td>
            <td>
                <form asp-action="Approve" method="post" style="display:inline">
                    <input type="hidden" name="id" value="@c.ClaimId" />
                    <button type="submit" class="btn btn-success">Approve</button>
                </form>
                <form asp-action="Reject" method="post" style="display:inline; margin-left:6px;">
                    <input type="hidden" name="id" value="@c.ClaimId" />
                    <input type="text" name="reason" placeholder="Reason (optional)" class="form-control" style="display:inline-block; width:160px;" />
                    <button type="submit" class="btn btn-danger">Reject</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
